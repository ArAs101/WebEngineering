{
  "name": "@bears/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:moderator": "node --env-file-if-exists=../../.env --import tsx scripts/seed-moderator.ts",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx scripts/seed.ts",
    "test": "node --import tsx --test test/routes.test.ts test/hardening.test.ts",
    "report:race": "node --env-file-if-exists=../../.env --import tsx scripts/report-race.ts",
    "test:limits": "node --import tsx --test --test-name-pattern=\"auth rate limits\" test/hardening.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/session": "^11.2.1",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/type-provider-zod": "^1.0.3",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
